FrameWidgetClass hod_root {
 ignorepointer 1
 position 0 0
 size 1 1
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass hod_dim {
   ignorepointer 1
   color 0 0 0 0.55
   position 0 0
   size 1 1
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   style rover_sim_colorable
  }
  FrameWidgetClass hod_window {
   ignorepointer 0
   position 0 0
   size 1180 720
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
  }
 }
}
